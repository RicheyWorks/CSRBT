{
 "id": "page-ethogram-science",
 "target": "page",
 "page": "ethogram.html",
 "goal": "Record one focal-animal continuous session on the ethogram against a clock the harness steps, so every duration is exact: forage 02:30 in two bouts (45.5% of 05:30 observed), vigilant 02:00 in two (36.4%), rest 01:00 (18.2%), 00:30 out of sight excluded from the denominator, six bouts; alarm twice and aggress once, 0.364 and 0.182 per observed minute over 5.5 min; and a transition matrix of three observed transitions, NOT four -- the pair spanning the out-of-sight gap is not a transition anybody watched. The session ran 06:20 and only 06:00 of it is in a state, which the budget now says instead of calling the second number elapsed. Then the five things this page hands over, read -- and the two observers whose ten scans give Cohen’s kappa 0.722 from 80% raw agreement against 28% expected by chance, which is the check the session was designed to be judged by.",
 "steps": [
  {
   "id": "look",
   "action": "observe"
  },
  {
   "id": "des",
   "action": "show-pane",
   "arguments": {
    "pane": "p-des"
   }
  },
  {
   "id": "focal",
   "action": "activate",
   "arguments": {
    "selector": "@control:dSample/focal animal"
   }
  },
  {
   "id": "cont",
   "action": "activate",
   "arguments": {
    "selector": "@control:dRecord/continuous"
   }
  },
  {
   "id": "scan",
   "action": "set-text",
   "arguments": {
    "selector": "@control:timeEntry/scan / interval",
    "value": "60"
   }
  },
  {
   "id": "len",
   "action": "set-text",
   "arguments": {
    "selector": "@control:timeEntry/session length",
    "value": "20"
   }
  },
  {
   "id": "obs",
   "action": "set-text",
   "arguments": {
    "selector": "@control:dObs",
    "value": "R. Wright"
   }
  },
  {
   "id": "date",
   "action": "set-text",
   "arguments": {
    "selector": "@control:dDate",
    "value": "2026-09-07"
   }
  },
  {
