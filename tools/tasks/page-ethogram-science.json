    "output.by.kOut.expected by chance": "28.0%",
    "output.by.kOut.samples": "10",
    "output.by.kOut.categories": "4",
    "output.boxes.kMatrix": {
     "op": "contains",
     "value": "commonest disagreement"
    }
   }
  },
  {
   "id": "after",
   "action": "read-report",
   "expect": {
    "output.by.budBox.observed": "05:30",
    "output.tables.budBox.1.0": "forage"
   }
  },
  {
   "id": "intact",
   "action": "read-page",
   "expect": {
    "output.junk": null,
    "output.errors": {
