   "action": "read-report",
   "expect": {
    "output.tables.budBox.1.0": "forage",
    "output.tables.budBox.1.1": "02:30",
    "output.tables.budBox.1.2": "45.5%",
    "output.tables.budBox.1.3": "2",
    "output.tables.budBox.1.4": "01:15",
    "output.tables.budBox.2.0": "vigilant",
    "output.tables.budBox.2.1": "02:00",
    "output.tables.budBox.2.2": "36.4%",
    "output.tables.budBox.2.3": "2",
