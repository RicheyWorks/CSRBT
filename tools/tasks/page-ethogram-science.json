    "output.tables.rateBox.1.3": "21.8",
    "output.tables.rateBox.2.0": "aggress",
    "output.tables.rateBox.2.1": "1",
    "output.tables.rateBox.2.2": "0.182",
    "output.tables.rateBox.2.3": "10.9",
