    "value": "Overcast, 14 C, light wind. Group of six, two juveniles. Observed from 40 m with 10x42."
   }
  },
  {
   "id": "subj",
   "action": "set-text",
   "arguments": {
    "selector": "@control:sNew",
    "value": "F-blue"
   }
  },
  {
   "id": "addsubj",
   "action": "activate",
   "arguments": {
    "selector": "@control:sAdd"
   }
  },
  {
   "id": "bname",
   "action": "set-text",
   "arguments": {
    "selector": "@control:eName",
    "value": "sun-bask"
   }
  },
  {
   "id": "bcode",
   "action": "set-text",
   "arguments": {
    "selector": "@control:eCode",
    "value": "BSK"
   }
  },
  {
   "id": "bkind",
   "action": "activate",
   "arguments": {
    "selector": "@control:kindEntry/state"
   }
  },
  {
   "id": "bdesc",
   "action": "set-text",
   "arguments": {
    "selector": "@control:eDesc",
    "value": "Lying with the flank or belly presented to the sun, limbs extended, not feeding, grooming or moving. Ends when the animal rises or rolls out of the sun."
   }
  },
  {
   "id": "baddb",
   "action": "activate",
   "arguments": {
    "selector": "@control:eAdd"
   }
  },
  {
