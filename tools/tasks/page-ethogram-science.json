   "action": "show-pane",
   "arguments": {
    "pane": "p-bud"
   }
  },
  {
   "id": "tiles",
   "action": "read-report",
   "expect": {
    "output.by.budBox.elapsed": "06:20",
    "output.by.budBox.observed": "05:30",
    "output.by.budBox.out of sight": "00:30",
    "output.by.budBox.bouts": "6"
   }
  },
  {
