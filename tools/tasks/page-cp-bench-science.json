{
 "id": "page-cp-bench-science",
 "target": "page",
 "page": "cp-bench.html",
 "goal": "On the carnivorous-plant bench: log TDS readings against the 50/160 ppm conventions from a named water source, work the top-up accumulation to a 500 ppm equivalent, load a media preset and copy the recipe, record a named plant with its provenance and three trap counts, check dormancy need, and log a cross with its note and seed set -- every pane driven and the figures and recipe held against an oracle. The plant's trap-count chart is one path through its three observations, captioned with the plant's name. The worked example's fifty-eight readings are drawn as one path and fifty-eight dots against the target band at 10 °C, every position the chart's own scale.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "cp-bench.html"
   }
  },
  {
   "id": "wat",
   "action": "show-pane",
   "arguments": {
    "pane": "p-wat"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "g161-src",
   "action": "activate",
   "arguments": {
    "selector": "@control:wEntry/RO / DI"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "tds20",
   "action": "set-text",
   "arguments": {
    "selector": "@control:TDS",
    "value": "20"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "log20",
   "action": "activate",
   "arguments": {
    "selector": "@control:wAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "w20",
   "action": "read-report",
   "expect": {
    "output.boxes.wOut": {
     "op": "contains",
     "value": "Excellent — 20 ppm."
    },
    "output.boxes.wList": {
     "op": "contains",
     "value": "inside the 50 ppm convention"
    },
    "output.by.wOut.latest reading": "20 ppm",
    "output.by.wOut.source": "RO / DI"
   }
  },
  {
