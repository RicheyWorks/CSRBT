{
 "id": "page-cp-bench-science",
 "target": "page",
 "page": "cp-bench.html",
 "goal": "On the carnivorous-plant bench: TDS readings of 20, 120 and 300 ppm are excellent, usable and too high against the 50/160 ppm conventions; ten 250 mL top-ups at 50 ppm leave 125 mg of solids in the pot, as one watering at 500 ppm; the Sarracenia/Dionaea preset (peat + perlite) is nutrient-free and coir makes it 0.33/5; a plant with no source is counted; trap counts 4, 6, 9 read as up from 4 to 9; the demo dormancy log has 43 of 84 needed days at or below 10 C with a longest run of 15; a cross with 200 seed and 80 seedlings germinated 40.0%.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "cp-bench.html"
   }
  },
  {
   "id": "wat",
   "action": "show-pane",
   "arguments": {
    "pane": "p-wat"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "tds20",
   "action": "set-text",
   "arguments": {
    "selector": "@control:TDS",
    "value": "20"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "log20",
   "action": "activate",
   "arguments": {
    "selector": "@control:wAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "w20",
   "action": "read-report",
   "expect": {
    "output.boxes.wOut": {
     "op": "contains",
     "value": "Excellent — 20 ppm."
    },
    "output.boxes.wList": {
     "op": "contains",
     "value": "inside the 50 ppm convention"
    },
    "output.by.wOut.latest reading": "20 ppm",
    "output.by.wOut.source": "RO / DI"
   }
  },
  {
   "id": "tds120",
   "action": "set-text",
   "arguments": {
    "selector": "@control:TDS",
    "value": "120"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "log120",
   "action": "activate",
   "arguments": {
    "selector": "@control:wAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "w120",
   "action": "read-report",
   "expect": {
    "output.boxes.wOut": {
     "op": "contains",
     "value": "Usable — 120 ppm."
    },
    "output.boxes.wList": {
     "op": "contains",
     "value": "under the 160 ppm guidance"
    },
    "output.by.wOut.latest reading": "120 ppm",
    "output.by.wOut.source": "RO / DI"
   }
  },
  {
   "id": "tds300",
   "action": "set-text",
   "arguments": {
    "selector": "@control:TDS",
    "value": "300"
   },
   "expect": {
    "ok": true
   }
  },
