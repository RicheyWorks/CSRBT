   "action": "read-report",
   "expect": {
    "output.boxes.wOut": {
     "op": "contains",
     "value": "Too high — 300 ppm."
    },
    "output.boxes.wList": {
     "op": "contains",
     "value": "above the 160 ppm guidance"
    },
    "output.by.wOut.latest reading": "300 ppm",
    "output.by.wOut.source": "RO / DI"
   }
