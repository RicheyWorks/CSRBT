{
 "id": "page-farm-scout-science",
 "target": "page",
 "page": "farm-scout.html",
 "goal": "On the farm scout's germination pane, test 40 seeds with 33 up wanting 120 plants and find 83%% and 146 seeds to sow (ceil(120/0.825)); 26 up gives 65%% and 185, 18 up 45%% and 267; on the rotation pane, Brassica last season and planned again is flagged within 3 years, and Fabaceae planned instead is a clean rotation; the scout pane's ten stops driven to 2 3 2 4 3 2 3 12 2 3 by the + buttons read mean 3.60 and variance/mean 2.54.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "farm-scout.html"
   }
  },
  {
   "id": "germ",
   "action": "show-pane",
   "arguments": {
    "pane": "p-germ"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "sown",
   "action": "set-text",
   "arguments": {
    "selector": "@control:seeds tested",
    "value": "40"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "up",
   "action": "set-text",
   "arguments": {
    "selector": "@control:germinated",
    "value": "33"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "want",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plants you want",
    "value": "120"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "g83",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.by.gOut.germination": "83%",
    "output.by.gOut.seeds to sow for 120 plants": "146"
