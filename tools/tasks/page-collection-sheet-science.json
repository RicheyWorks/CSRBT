{
 "id": "page-collection-sheet-science",
 "target": "page",
 "page": "collection-sheet.html",
 "goal": "On the collection sheet, record a search of 1000 m² over 90 minutes and five collections -- Amanita muscaria x1, Suillus brevipes x1, Russula brevipes x1, Cortinarius cf. vanduzerensis x2, Pleurotus pulmonarius x5, each on its host -- then open the analysis and find the sheet's arithmetic right: 5 collections, 10 fruit bodies, Sobs 5, Chao1 6.5 (5 + 3·2 / (2·(1+1))), singletons/doubletons 3 / 1, Shannon H′ 1.359 and Pielou J′ 0.845 for p = .1 .1 .1 .2 .5, 0.50 collections per 100 m², 3.3 collections per hour.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "collection-sheet.html"
   }
  },
  {
   "id": "site",
   "action": "show-pane",
   "arguments": {
    "pane": "p-site"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "area",
   "action": "set-text",
   "arguments": {
    "selector": "@control:area searched",
    "value": "1000"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "minutes",
   "action": "set-text",
   "arguments": {
    "selector": "@control:search time",
    "value": "90"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "area-back",
   "action": "read-control",
   "arguments": {
    "selector": "@control:area searched"
   },
   "expect": {
    "output.value": "1000"
   }
  },
  {
   "id": "rec",
