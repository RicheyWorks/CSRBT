   "arguments": {
    "selector": "@control:rAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "s3",
   "action": "pick",
   "arguments": {
    "selector": "@control:recEntry",
    "value": "cheatgrass"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "c3",
   "action": "activate",
   "arguments": {
    "selector": "@control:rCov/+"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "a3",
   "action": "activate",
