{
 "id": "page-releve-science",
 "target": "page",
 "page": "releve.html",
 "goal": "On the relevé, record three taxa in the herb stratum by cover class -- big sagebrush 4 (midpoint 62.5%), bluebunch wheatgrass 2 (15%), cheatgrass + (0.5%) -- and find the analysis right: 3 taxa in 2 families, Shannon H′ 0.53 and evenness J′ 0.48 on the cover shares (62.5 : 15 : 0.5 of 78), effective taxa 1.7, one non-native, the dominant at 80%; an add with no cover class adds no row; the LPI plan for a 25 m transect at 0.5 m is 50 points (±5.7) and four transects 200 (±2.8); three taxa scored FAC give a prevalence index of 3.00.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "releve.html"
   }
  },
  {
   "id": "rec",
   "action": "show-pane",
   "arguments": {
    "pane": "p-rec"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "s1",
   "action": "pick",
   "arguments": {
    "selector": "@control:recEntry",
    "value": "big sagebrush"
   },
   "expect": {
    "ok": true,
    "output.chose": {
     "op": "contains",
     "value": "big sagebrush"
    }
   }
  },
  {
   "id": "c1",
   "action": "activate",
   "arguments": {
    "selector": "@control:rCov/4"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "a1",
   "action": "activate",
   "arguments": {
    "selector": "@control:rAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "s2",
   "action": "pick",
   "arguments": {
