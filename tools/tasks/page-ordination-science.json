{
 "id": "page-ordination-science",
 "target": "page",
 "page": "ordination.html",
 "goal": "On the ordination page: the two-gradient demo parses to 20 sites x 24 species, NMDS in 2 dimensions carries a stress with Clarke's bands, the Shepard diagram fits 190 pairs (20*19/2), PCoA reports axis percentages over positive eigenvalues only with negative eigenvalues counted for a semi-metric; the no-structure demo will not help you read the picture; three sites are refused (four minimum); four sites at k=2 fit exactly by construction at stress 0.000 with the free-coordinates warning, five sites without it; an empty site, an unreadable value and a quoted comma in a species name are each named, not swallowed.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "ordination.html"
   }
  },
  {
   "id": "data",
   "action": "show-pane",
   "arguments": {
    "pane": "p-data"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "demo",
   "action": "activate",
   "arguments": {
    "selector": "@control:demo1"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "parsed",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.by.parseOut.sites": "20",
    "output.by.parseOut.species": "24"
   }
  },
  {
   "id": "nmds",
   "action": "read-report",
   "expect": {
    "output.boxes.ordVerdict": {
     "op": "contains",
     "value": "Clarke"
    },
    "output.by.ordStat.dimensions": "2",
    "output.by.ordStat.sites": "20",
    "output.by.ordStat.stress": {
     "op": "exists",
     "value": true
    }
   }
  },
  {
   "id": "diag",
   "action": "show-pane",
   "arguments": {
    "pane": "p-diag"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "shepard",
   "action": "read-report",
   "expect": {
    "output.boxes.shepNote": {
     "op": "contains",
     "value": "Worst-placed pairs"
    },
    "output.by.stressBox.sites": "20",
    "output.by.stressBox.pairs fitted": "190"
   }
  },
  {
   "id": "ord",
   "action": "show-pane",
   "arguments": {
    "pane": "p-ord"
   },
   "expect": {
    "ok": true
   }
