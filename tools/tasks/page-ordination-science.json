     "value": "positive eigenvalues only"
    },
    "output.by.ordStat.axis 1": {
     "op": "exists",
     "value": true
    },
    "output.by.ordStat.negative eigenvalues": {
     "op": "!=",
     "value": "0"
    }
   }
  },
