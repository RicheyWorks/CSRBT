{
 "id": "page-greenhouse-science",
 "target": "page",
 "page": "greenhouse.html",
 "goal": "On the greenhouse monitor: 40,000 lux under HPS (factor 82) converts to 488 umol/m2/s and 31.6 mol/m2/d over 18 h; 600 umol/m2/s is DLI 38.9 (600 x 18 x 0.0036) and 25.9 over 12 h; 400 g on a 600 W rated fixture is 0.67 g/W while every figure that divides by kWh stays blank without a power log; the five example runs (498/78.2, 512/80.9, 471/79.4, 505/81.6 g/kWh baselines and 548/84.1 new) have baseline mean 6.20, sample SD 0.20, CV 3%, per-run z with self excluded +1.1 +0.8 -3.8 -0.1 and the new run at +1.6, at the edge. And the path a reader takes when they say no: the page asks 'Clear every saved run?' before it clears, and answering no keeps the five runs -- a branch nothing could reach before the harness could decide what a dialog gets answered (ADR-134). Then, under a frozen clock, the worked example loaded whole -- 337 readings over 7.0 days -- and read against the clone band with the leaf 1.5 C below air: mean leaf VPD 1.00 kPa (range 0.59–1.44), 78% of TIME outside the band by duration, dew point 17.4 C with 9.8 C of margin, absolute humidity 14.3 g/m3; DLI integrated from the log 50.5 mol/m2/d; 82.9 kWh over the log at 0.180 per kWh, 4.83 g/kWh against 0.67 g/W rated, average draw 493 W (82% of rated) -- and STILL 493 W after a 70-day cycle length is entered, because the average draw is over the days the log covers and not over a cycle the log did not measure; a run saved and marked baseline; and the summary, the CSV and the print, read.",
 "policy": {
  "allow": [
   "SENSITIVE_READ",
   "DRAFT",
   "MUTATE",
   "DESTRUCTIVE"
  ],
  "needs": [
   "refuseWipe"
  ],
  "why": "the goal is that wiping the runs REMOVES runChart from the report: runWipe is 'Clear all runs'"
 },
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "greenhouse.html"
   }
  },
  {
   "id": "light",
   "action": "show-pane",
   "arguments": {
    "pane": "p-light"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "hps",
   "action": "pick",
   "arguments": {
    "selector": "@control:Fixture class (sets the lux factor) filter",
    "value": "HPS"
   },
   "expect": {
    "ok": true,
    "output.chose": {
     "op": "contains",
     "value": "HPS"
    }
   }
  },
  {
   "id": "lux",
   "action": "press-step",
   "arguments": {
    "selector": "@control:lightCtl/+#2",
    "direction": "up"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "converted",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.by.lightOut.PPFD at canopy": "488 µmol/m²/s",
    "output.by.lightOut.DLI, constant-PPFD formula": "31.6 mol/m²/d"
   }
  },
  {
   "id": "ppfd",
   "action": "set-text",
   "arguments": {
    "selector": "@control:PPFD at canopy",
    "value": "600"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "flat",
   "action": "read-report",
   "expect": {
    "output.by.lightOut.PPFD at canopy": "600 µmol/m²/s",
    "output.by.lightOut.DLI, constant-PPFD formula": "38.9 mol/m²/d"
   }
  },
  {
   "id": "pp12",
   "action": "set-text",
   "arguments": {
    "selector": "@control:Photoperiod",
    "value": "12"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "flat12",
   "action": "read-report",
   "expect": {
    "output.by.lightOut.DLI, constant-PPFD formula": "25.9 mol/m²/d"
   }
  },
  {
   "id": "econ",
   "action": "show-pane",
   "arguments": {
    "pane": "p-econ"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "yield",
   "action": "press-step",
   "arguments": {
    "selector": "@control:econCtl/+#0",
    "direction": "up"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "watts",
   "action": "press-step",
   "arguments": {
    "selector": "@control:econCtl/+#1",
    "direction": "up"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "gpw",
   "action": "read-report",
   "expect": {
    "output.boxes.econOut": {
     "op": "contains",
     "value": "log carries no power column"
    },
    "output.by.econOut.grams per RATED watt": "0.67 g/W",
    "output.by.econOut.energy over the log": "— kWh",
    "output.by.econOut.grams per kilowatt hour": "— g/kWh"
   }
  },
  {
   "id": "runs",
   "action": "show-pane",
   "arguments": {
    "pane": "p-runs"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "demo",
   "action": "activate",
   "arguments": {
    "selector": "@control:runDemo"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "noise",
   "action": "read-report",
   "expect": {
    "output.boxes.runOut": {
     "op": "contains",
     "value": "5 runs — comparing on g/kWh"
    },
    "output.by.runOut.coefficient of variation": "3 %",
    "output.by.runOut.baseline mean": {
     "op": "contains",
     "value": "6.20"
    },
    "output.by.runOut.your run-to-run SD": {
     "op": "contains",
     "value": "0.20"
    }
   }
  },
  {
   "id": "charts",
   "action": "read-report",
   "expect": {
    "output.charts.runChart.viewBox": "0 0 680 250",
    "output.charts.runChart.marks.circle": 5,
    "output.charts.runChart.longest": 5,
    "output.charts.runChart.at.0.0": 52,
    "output.charts.runChart.at.1.0": 203,
    "output.charts.runChart.at.2.0": 354,
    "output.charts.runChart.at.3.0": 505,
    "output.charts.runChart.at.4.0": 656,
    "output.charts.runChart.texts.0.y": 36,
    "output.charts.runChart.texts.1.y": 198
   }
  },
  {
   "id": "table",
   "action": "read-report",
   "expect": {
    "output.tables.runOut.1.2": "6.37",
    "output.tables.runOut.1.3": "+1.1",
    "output.tables.runOut.3.2": "5.93",
    "output.tables.runOut.3.3": "-3.8",
    "output.tables.runOut.5.2": "6.52",
    "output.tables.runOut.5.3": "+1.6",
    "output.tables.runOut.4.3": "-0.1"
   }
  },
  {
   "id": "edge",
   "action": "read-report",
   "expect": {
    "output.boxes.runOut": {
     "op": "contains",
     "value": "at the edge of your spread"
    }
   }
  },
  {
   "id": "sayNo",
   "action": "set-dialog",
   "arguments": {
    "confirm": false
   },
   "expect": {
    "ok": true,
    "output.confirm": false,
    "snapshot.environment.confirm": false
   }
  },
  {
   "id": "refuseWipe",
   "action": "activate",
   "arguments": {
    "selector": "@control:runWipe"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "asked",
   "action": "read-dialogs",
   "expect": {
    "ok": true,
    "output.count": 1,
    "output.dialogs.0.kind": "confirm",
    "output.dialogs.0.text": "Clear every saved run?"
   }
  },
  {
   "id": "kept",
   "action": "read-report",
   "expect": {
    "output.boxes.runOut": {
     "op": "contains",
     "value": "5 runs"
    }
   }
  },
  {
   "id": "sayYes",
   "action": "set-dialog",
   "arguments": {
    "confirm": true
   },
   "expect": {
    "ok": true,
    "snapshot.environment.confirm": true
   }
  },
  {
   "id": "doWipe",
   "action": "activate",
   "arguments": {
    "selector": "@control:runWipe"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "gone",
   "action": "read-report",
   "expect": {
    "output.boxes.runOut#2": {
     "op": "excludes",
     "value": "5 runs"
    },
    "output.charts": {
     "op": "excludes",
     "value": "runChart"
    }
   }
  },
  {
   "id": "g155-t0",
   "action": "set-clock",
   "arguments": {
    "at": "2026-09-07T09:00:00Z"
   }
  },
  {
   "id": "g155-src",
   "action": "show-pane",
   "arguments": {
    "pane": "p-src"
   }
  },
  {
   "id": "g155-demo",
   "action": "activate",
   "arguments": {
    "selector": "@control:srcCtl/Worked example"
   }
  },
  {
   "id": "g155-load",
   "action": "activate",
   "arguments": {
    "selector": "@control:srcRun"
   }
  },
  {
   "id": "g155-loaded",
   "action": "read-report",
   "expect": {
    "output.boxes.logNote": {
     "op": "contains",
     "value": "337 readings loaded; the last 12 are shown."
    },
    "output.boxes.logNote#2": {
     "op": "contains",
     "value": "These are generated, not measured."
    },
    "output.tables.logTable.1.1": "27.1",
    "output.tables.logTable.1.2": "55",
    "output.tables.logTable.1.4": "634",
    "output.tables.logTable.1.5": "761"
   }
  },
  {
   "id": "g155-env",
   "action": "show-pane",
   "arguments": {
    "pane": "p-env"
   }
  },
  {
   "id": "g155-clone",
   "action": "activate",
   "arguments": {
    "selector": "@control:envCtl/clones / seedlings"
   }
  },
  {
   "id": "g155-off",
   "action": "set-text",
   "arguments": {
    "selector": "@control:envCtl/Leaf temperature offset",
    "value": "1.5"
   }
  },
  {
   "id": "g155-readout",
   "action": "read-report",
   "expect": {
    "output.boxes.envOut": {
     "op": "contains",
     "value": "Readout — clones / seedlings (0.4–0.8 kPa)"
    },
    "output.by.envOut.mean leaf VPD": "1.00 kPa",
    "output.by.envOut.VPD range": "0.59–1.44 kPa",
    "output.by.envOut.of TIME outside the band": "78 %",
    "output.by.envOut.dew point, last reading": "17.4 °C",
    "output.by.envOut.absolute humidity": "14.3 g/m³",
    "output.by.envOut.readings": "337",
    "output.boxes.envOut#2": {
     "op": "contains",
     "value": "leaf = air − 1.5 °C"
    },
    "output.boxes.envOut#3": {
     "op": "contains",
     "value": "9.8 °C of margin"
    },
    "output.boxes.envOut#4": {
     "op": "contains",
     "value": "VPD trend: -0.001 kPa per day"
    },
    "output.boxes.envOut#5": {
     "op": "contains",
     "value": "r² = 0.00"
    },
    "output.boxes.envOut#6": {
     "op": "contains",
     "value": "These are generated numbers."
    },
    "output.boxes.envChart": {
     "op": "contains",
     "value": "Leaf VPD over 7.0 days"
    }
   }
  },
  {
   "id": "g155-light",
   "action": "show-pane",
   "arguments": {
    "pane": "p-light"
   }
  },
  {
   "id": "g155-dli",
   "action": "read-report",
   "expect": {
    "output.by.lightOut.DLI integrated from your log": "50.5 mol/m²/d",
    "output.boxes.lightOut": {
     "op": "contains",
     "value": "trapezoid over the actual curve"
    }
   }
  },
  {
   "id": "g155-econ",
   "action": "show-pane",
   "arguments": {
    "pane": "p-econ"
   }
  },
  {
   "id": "g155-rate",
   "action": "set-text",
   "arguments": {
    "selector": "@control:econCtl/Electricity rate",
    "value": "0.18"
   }
  },
  {
   "id": "g155-energy",
   "action": "read-report",
   "expect": {
    "output.by.econOut.energy over the log": "82.9 kWh",
    "output.by.econOut.electricity for that energy": "$$14.92",
    "output.by.econOut.grams per kilowatt hour": "4.83 g/kWh",
    "output.by.econOut.grams per RATED watt": "0.67 g/W",
    "output.by.econOut.electricity cost per gram": "$$0.04",
    "output.by.econOut.average draw": "493 W",
    "output.boxes.econOut": {
     "op": "contains",
     "value": "82% of rated"
    },
    "output.boxes.econOut#2": {
     "op": "contains",
     "value": "trapezoid over 7.0 days"
    },
    "output.boxes.econOut#3": {
     "op": "contains",
     "value": "at 0.180 per kWh"
    }
   }
  },
  {
   "id": "g155-cycle",
   "action": "set-text",
   "arguments": {
    "selector": "@control:econCtl/Cycle length",
    "value": "70"
   }
  },
  {
   "id": "g155-still",
   "action": "read-report",
   "expect": {
    "output.by.econOut.average draw": "493 W",
    "output.boxes.econOut": {
     "op": "contains",
     "value": "82% of rated"
    },
    "output.boxes.econOut#2": {
     "op": "excludes",
     "value": "49 W"
    }
   }
  },
  {
   "id": "g155-runs",
   "action": "show-pane",
   "arguments": {
    "pane": "p-runs"
   }
  },
  {
   "id": "g155-label",
   "action": "set-text",
   "arguments": {
    "selector": "@control:runLabel",
    "value": "autumn 2026, tent A"
   }
  },
  {
   "id": "g155-base",
   "action": "activate",
   "arguments": {
    "selector": "@control:runCtl/baseline — nothing deliberately changed"
   }
  },
  {
   "id": "g155-metric",
   "action": "activate",
   "arguments": {
    "selector": "@control:runCtl/g/kWh"
   }
  },
  {
   "id": "g155-save",
   "action": "activate",
   "arguments": {
    "selector": "@control:runSave"
   }
  },
  {
   "id": "g155-saved",
   "action": "read-report",
   "expect": {
    "output.boxes.runMsg": {
     "op": "contains",
     "value": "Saved “autumn 2026, tent A”."
    },
    "output.boxes.runOut": {
     "op": "contains",
     "value": "1 run — comparing on g/kWh"
    },
    "output.boxes.runOut#2": {
     "op": "contains",
     "value": "GENERATED"
    }
   }
  },
  {
   "id": "g155-out",
   "action": "show-pane",
   "arguments": {
    "pane": "p-out"
   }
  },
  {
   "id": "g155-sheet",
   "action": "read-report",
   "expect": {
    "output.boxes.ghOut": {
     "op": "contains",
     "value": "# source: Worked example (generated, not measured) (GENERATED, NOT MEASURED)"
    },
    "output.boxes.ghOut#2": {
     "op": "contains",
     "value": "# leaf offset used: 1.5 C below air"
    },
    "output.boxes.ghOut#3": {
     "op": "contains",
     "value": "# readings: 337 over 7.00 days"
    },
    "output.boxes.ghOut#4": {
     "op": "contains",
     "value": "mean leaf VPD 0.998 kPa (range 0.591-1.444)"
    },
    "output.boxes.ghOut#5": {
     "op": "contains",
     "value": "time outside band 77.7%"
    },
    "output.boxes.ghOut#6": {
     "op": "contains",
     "value": "VPD trend -0.0007 kPa/day, r2=0.000, n=337"
    },
    "output.boxes.ghOut#7": {
     "op": "contains",
     "value": "DLI (integrated) 50.51 mol/m2/d"
    },
    "output.boxes.ghOut#8": {
     "op": "contains",
     "value": "energy 82.89 kWh"
    },
    "output.boxes.ghOut#9": {
     "op": "contains",
     "value": "g/kWh 4.826"
    },
    "output.boxes.ghOut#10": {
     "op": "contains",
     "value": "g/W (rated) 0.667"
    },
    "output.boxes.ghOut#11": {
     "op": "contains",
     "value": "average draw 493 W (82% of rated)"
    }
   }
  },
  {
   "id": "g155-copy",
   "action": "activate",
   "arguments": {
    "selector": "@control:ghCopy"
   }
  },
  {
   "id": "g155-copyout",
   "action": "collect-output",
   "expect": {
    "output.payloads.0.k": {
     "op": "in",
     "value": [
      "copy",
      "clipboard",
      "download",
      "print"
     ]
    },
    "output.payloads.0.text": {
     "op": "contains",
     "value": "# Greenhouse Monitor — summary"
    },
    "output.payloads.0.text#2": {
     "op": "contains",
     "value": "  mean leaf VPD      0.998 kPa   (range 0.591-1.444)"
    },
    "output.payloads.0.text#3": {
     "op": "contains",
     "value": "  energy             82.89 kWh"
    },
    "output.payloads.0.text#4": {
     "op": "contains",
     "value": "  g/kWh              4.826    <- divides into your bill"
    },
    "output.payloads.0.text#5": {
     "op": "contains",
     "value": "  average draw       493 W (82% of rated)"
    }
   }
  },
  {
   "id": "g155-csv",
   "action": "activate",
   "arguments": {
    "selector": "@control:ghCsv"
   }
  },
  {
   "id": "g155-csvout",
   "action": "collect-output",
   "expect": {
    "output.payloads.0.k": {
     "op": "in",
     "value": [
      "copy",
      "clipboard",
      "download",
      "print"
     ]
    },
    "output.payloads.0.text": {
     "op": "contains",
     "value": "time,temp_c,rh_pct,vpd_kpa,dew_c,ah_g_m3,watts,ppfd,co2"
    },
    "output.payloads.0.text#2": {
     "op": "contains",
     "value": "2026-08-31T09:00:00.000Z,26.88,55.1,"
    },
    "output.payloads.0.text#3": {
     "op": "contains",
     "value": "2026-09-07T09:00:00.000Z,27.12,55.2,"
    }
   }
  },
  {
   "id": "g155-print",
   "action": "activate",
   "arguments": {
    "selector": "@control:p-out/Print / save PDF"
   }
  },
  {
   "id": "g155-printout",
   "action": "collect-output",
   "expect": {
    "output.payloads.0.k": "print"
   }
  },
  {
   "id": "g155-close",
   "action": "read-report",
   "expect": {
    "output.by.econOut.average draw": "493 W",
    "output.boxes.ghOut": {
     "op": "contains",
     "value": "energy 82.89 kWh"
    }
   }
  },
  {
   "id": "intact",
   "action": "read-page",
   "expect": {
    "output.junk": null,
    "output.errors": {
     "op": "==",
     "value": []
    },
    "output.overflow": 0
   }
  }
 ]
}
