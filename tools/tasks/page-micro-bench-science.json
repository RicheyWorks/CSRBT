{
 "id": "page-micro-bench-science",
 "target": "page",
 "page": "micro-bench.html",
 "goal": "On the micro bench: 148 colonies from 0.1 mL at 10^-5 is 1.48x10^8 CFU/mL (Poisson CV 8.2%); 17 colonies at 10^-6 is TFTC and excluded; 50 at 10^-5 makes the countable mean 9.90x10^7 with the plates disagreeing by 3.0x; a 10^8 titre in 1:10 steps lands in 30-300 at step 5; OD 0.05 0.10 0.20 0.40 at hours 0-3 fits mu = ln 2 = 0.6931 per hour, doubling 1.000 h = 60.0 min, r2 1.0000; an 18 mm zone is measurement only until breakpoints S >= 17 R <= 13 (CLSI M100, 2026) interpret it with an intermediate band 13.5-16.5 mm.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "micro-bench.html"
   }
  },
  {
   "id": "pl",
   "action": "show-pane",
   "arguments": {
    "pane": "p-pl"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "nA",
   "action": "press-step",
   "arguments": {
    "selector": "@control:plEntry/+",
    "direction": "up"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "cA",
   "action": "set-text",
   "arguments": {
    "selector": "@control:colonies",
    "value": "148"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "lA",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plL",
    "value": "TSA-A"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "addA",
   "action": "activate",
   "arguments": {
    "selector": "@control:plAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "plateA",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.rows.#plList": 1,
    "output.by.plOut.CFU/mL (mean of countable)": "1.48×10⁸",
    "output.by.plOut.countable plates": "1 / 1",
    "output.by.plOut.colonies counted": "148",
    "output.by.plOut.Poisson CV": "±8.2%"
   }
  },
  {
   "id": "nB",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plEntry/dilution",
    "value": "6"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "cB",
   "action": "set-text",
   "arguments": {
    "selector": "@control:colonies",
    "value": "17"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "lB",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plL",
    "value": "TSA-B"
   },
   "expect": {
    "ok": true
   }
  },
