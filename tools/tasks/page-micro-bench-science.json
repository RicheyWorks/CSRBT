{
 "id": "page-micro-bench-science",
 "target": "page",
 "page": "micro-bench.html",
 "goal": "On the micro bench: 148 colonies from 0.1 mL plated at 10^-5 is 1.48x10^8 CFU/mL, the plated volume and the serial transfer/diluent volumes set explicitly (1:10 per step, 1.00 log10); a growth curve, and a zone-of-inhibition read against CLSI breakpoints with the medium and organism named -- every pane driven and the figures held against an oracle.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "micro-bench.html"
   }
  },
  {
   "id": "pl",
   "action": "show-pane",
   "arguments": {
    "pane": "p-pl"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "g164-plv",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plEntry/volume plated",
    "value": "0.1"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "nA",
   "action": "press-step",
   "arguments": {
    "selector": "@control:plEntry/+",
    "direction": "up"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "cA",
   "action": "set-text",
   "arguments": {
    "selector": "@control:colonies",
    "value": "148"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "lA",
   "action": "set-text",
   "arguments": {
    "selector": "@control:plL",
    "value": "TSA-A"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "addA",
   "action": "activate",
   "arguments": {
    "selector": "@control:plAdd"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "plateA",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.rows.#plList": 1,
    "output.by.plOut.CFU/mL (mean of countable)": "1.48×10⁸",
    "output.by.plOut.countable plates": "1 / 1",
    "output.by.plOut.colonies counted": "148",
    "output.by.plOut.Poisson CV": "±8.2%"
   }
  },
  {
   "id": "nB",
   "action": "set-text",
