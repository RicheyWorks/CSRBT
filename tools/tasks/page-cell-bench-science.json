  {
   "id": "count",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.by.cntOut.live cells/mL": "6.00×10⁵",
    "output.by.cntOut.cells per square (all)": "33.0",
    "output.by.cntOut.viability": "90.9%",
    "output.by.cntOut.counting CV (Poisson)": "±9.1%",
    "output.by.cntOut.live counted": "120",
    "output.by.cntOut.cells in 10\\.0 mL": "6.00×10⁶"
   }
  },
