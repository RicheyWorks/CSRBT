{
 "id": "page-cell-bench-science",
 "target": "page",
 "page": "cell-bench.html",
 "goal": "On the cell bench: 120 live and 12 dead in 4 large squares at dilution 2 is 6.00x10^5 live cells/mL, 33.0 per square, 90.9% viable, Poisson CV 9.1%; seeding 10 mL at 5x10^4 from 8.5x10^5 stock takes 0.588 mL; 2x10^5 to 1.6x10^6 in 48 h is 3.00 doublings of 16.00 h; standards (0,.041) (5,.238) (10,.442) (20,.851) fit A = 0.0406c + 0.0380 with r2 0.9999 and read A 0.500 as 11.3875; Beer-Lambert 1.842/6500 is 2.83x10^-4 M; A260/A280 1.87; five phases scored once each is a mitotic index of 80.00%.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "cell-bench.html"
   }
  },
  {
   "id": "live",
   "action": "set-text",
   "arguments": {
    "selector": "@control:live cells counted",
    "value": "120"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "dead",
   "action": "set-text",
   "arguments": {
    "selector": "@control:dead cells counted",
    "value": "12"
   },
   "expect": {
    "ok": true
   }
