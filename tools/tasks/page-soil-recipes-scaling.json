{
 "id": "page-soil-recipes-scaling",
 "target": "page",
 "page": "soil-recipes.html",
 "goal": "On the soil recipes page, Subcool's Super Soil at 1x shows its published strings verbatim (25-50 lb castings, 3/4 cup Epsom salts, 2 tbsp humic acid) with a sourced export; at 1/4 every amount scales by the page's rules (6.3-12.5 lb, 3 tbsp, 1.5 tsp -- no half tablespoons) and at 4x (100-200 lb, 3 cups, 8 tbsp); Coot's rock dust is 12-16 cups at 4x and 12 tbsp-1 cup at 1/4 because the two ends land in different units.",
 "steps": [
  {
   "id": "look",
   "action": "observe",
   "expect": {
    "ok": true,
    "snapshot.page": "soil-recipes.html"
   }
  },
  {
   "id": "subcool",
   "action": "activate",
   "arguments": {
    "selector": "@control:recPick/🧱 Subcool's Super Soil"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "one",
   "action": "activate",
   "arguments": {
    "selector": "@control:recScale/1×"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "published",
   "action": "read-report",
   "expect": {
    "ok": true,
    "output.tables.recOut.2.0": "25–50 lb",
    "output.tables.recOut.7.0": "¾ cup",
    "output.tables.recOut.10.0": "2 tbsp",
    "output.boxes.recExport": {
     "op": "contains",
     "value": "https://"
    }
   }
  },
  {
   "id": "quarter",
   "action": "activate",
   "arguments": {
    "selector": "@control:recScale/¼"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "scaled-down",
   "action": "read-report",
   "expect": {
    "output.tables.recOut.1.0": "2 bags",
    "output.tables.recOut.2.0": "6.3–12.5 lb",
    "output.tables.recOut.3.0": "1.3 lb",
    "output.tables.recOut.4.0": "1.3 lb",
    "output.tables.recOut.5.0": "1.3 lb",
    "output.tables.recOut.6.0": "0.8 lb",
    "output.tables.recOut.7.0": "3 tbsp",
    "output.tables.recOut.8.0": "2–4 tbsp",
    "output.tables.recOut.9.0": "2 tbsp",
    "output.tables.recOut.10.0": "1.5 tsp"
   }
  },
  {
   "id": "quad",
   "action": "activate",
   "arguments": {
    "selector": "@control:recScale/4×"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "scaled-up",
   "action": "read-report",
   "expect": {
    "output.tables.recOut.1.0": "32 bags",
    "output.tables.recOut.2.0": "100–200 lb",
    "output.tables.recOut.3.0": "20 lb",
    "output.tables.recOut.4.0": "20 lb",
    "output.tables.recOut.5.0": "20 lb",
    "output.tables.recOut.6.0": "12 lb",
    "output.tables.recOut.7.0": "3 cups",
    "output.tables.recOut.8.0": "2–4 cups",
    "output.tables.recOut.9.0": "2 cups",
    "output.tables.recOut.10.0": "8 tbsp"
   }
  },
  {
   "id": "coot",
   "action": "activate",
   "arguments": {
    "selector": "@control:recPick/🌿 Clackamas Coot's mix"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "coot4",
   "action": "read-report",
   "expect": {
    "output.tables.recOut.1.0": "1 part",
    "output.tables.recOut.10.0": "12–16 cups"
   }
  },
  {
   "id": "cootq",
   "action": "activate",
   "arguments": {
    "selector": "@control:recScale/¼"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "cootquarter",
   "action": "read-report",
   "expect": {
    "output.tables.recOut.10.0": "12 tbsp–1 cup",
    "output.tables.recOut.4.0": "4 tbsp"
   }
  },
  {
   "id": "intact",
   "action": "read-page",
   "expect": {
    "output.junk": null,
    "output.errors": {
     "op": "==",
     "value": []
    },
    "output.overflow": 0
   }
  }
 ]
}