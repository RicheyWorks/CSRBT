# Build
bin/
build/
.gradle/
.jqwik-database
*.class

# Stray jars (dependencies come from Maven Central via Gradle — ADR-013).
# The wrapper jar is the one jar that MUST be committed.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE / editors
.idea/
*.iml
.vscode/
*.geany
.geany/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test-run snapshot artifacts (tests clean up after themselves; interrupted
# runs leave strays — never commit any of it; the directory is created at runtime)
snapshots/

# Scratch
*.tmp

# Agent scratch drop-box (the sandbox cannot delete; it moves files here instead)
_to_delete/
